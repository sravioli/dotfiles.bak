# Upstream repos cloned directly into place by chezmoi.
# Refreshed at most weekly; run `chezmoi --refresh-externals apply` to force.

{{ if eq .chezmoi.os "windows" -}}
["AppData/Local/nvim"]
{{- else -}}
[".config/nvim"]
{{- end }}
    type = "git-repo"
    url = "https://github.com/sravioli/nvim.git"
    refreshPeriod = "168h"

[".config/wezterm"]
    type = "git-repo"
    url = "https://github.com/sravioli/wezterm.git"
    refreshPeriod = "168h"

# gitalias.txt fetched from upstream (https://github.com/GitAlias/gitalias) and
# wired in via `[include]` in dot_config/git/config.tmpl. Pin to a commit by
# putting its sha in the URL instead of `main`.
[".config/git/gitalias.txt"]
    type = "file"
    url = "https://raw.githubusercontent.com/GitAlias/gitalias/main/gitalias.txt"
    refreshPeriod = "168h"
