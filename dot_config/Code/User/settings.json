{
  "workbench.colorTheme": "Kanagawa Wave",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "git.openRepositoryInParentFolders": "always",
  "editor.fontFamily": "FiraCode Nerd Font",
  "vscode-neovim.compositeKeys": {
    "jk": {
      "command": "vscode-neovim.escape",
    },
  },
  "editor.fontSize": 12.5,
  "editor.formatOnSave": true,
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
    "editor.rulers": [80],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.rulers": [100],
  },
  "workbench.startupEditor": "none",
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.foldingImportsByDefault": true,
  "editor.showFoldingControls": "always",
  "editor.stickyScroll.defaultModel": "foldingProviderModel",
  "vscode-neovim.ctrlKeysForNormalMode": [
    "a",
    "b",
    "c",
    "d",
    "e",
    "f",
    "h",
    "i",
    "j",
    "k",
    "l",
    "m",
    "o",
    "r",
    "t",
    "u",
    "v",
    "w",
    "x",
    "y",
    "z",
    "/",
    "]",
    "right",
    "left",
    "up",
    "down",
    "backspace",
    "delete",
    "q",
  ],
  "editor.lineNumbers": "relative",
  "workbench.editorAssociations": {
    "*.md": "default",
  },
  "powershell.codeFormatting.autoCorrectAliases": true,
  "powershell.codeFormatting.avoidSemicolonsAsLineTerminators": true,
  "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
  "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
  "powershell.codeFormatting.useConstantStrings": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "powershell.codeFormatting.whitespaceBetweenParameters": true,
  "powershell.startAsLoginShell.osx": false,
  "powershell.analyzeOpenDocumentsOnly": true,
  "files.associations": {
    "*.ps1": "powershell",
    "sm": "shellscript",
    ".busted": "lua",
    ".chrono": "lua",
    ".luacov": "lua",
  },
  "explorer.confirmDragAndDrop": false,
  "extensions.autoCheckUpdates": false,
  "colorize.languages": [
    "css",
    "sass",
    "scss",
    "less",
    "postcss",
    "sss",
    "stylus",
    "xml",
    "svg",
    "ron",
    "xaml",
  ],
  "vscode-neovim.wslDistribution": "Ubuntu",
  "vscode-neovim.neovimExecutablePaths.linux": "/opt/nvim-linux64/bin/nvim",
  "markdown-preview-enhanced.codeBlockTheme": "one-dark.css",
  "markdown-preview-enhanced.enableCriticMarkupSyntax": true,
  "markdown-preview-enhanced.enableHTML5Embed": true,
  "markdown-preview-enhanced.mermaidTheme": "dark",
  "markdown-preview-enhanced.previewColorScheme": "editorColorScheme",
  "markdown-preview-enhanced.previewTheme": "one-dark.css",
  "markdown-preview-enhanced.enablePreviewZenMode": false,
  "redhat.telemetry.enabled": false,
  "assorted-biscuits.languageSettings": {
    "csharp": {
      "annotationMinDistance": 2,
      "annotationPrefix": " // ",
    },
    "yaml": {
      "annotationMinDistance": 2,
      "annotationPrefix": " # ",
    },
    "toml": {
      "annotationPrefix": " # ",
    },
    "rust": {
      "annotationPrefix": " // ",
    },
    "python": {
      "annotationPrefix": " # ",
    },
    "lua": {
      "annotationPrefix": " -- ",
    },
    "json": {
      "annotationPrefix": " // ",
    },
    "java": {
      "annotationPrefix": " // ",
    },
    "go": {
      "annotationPrefix": " // ",
    },
    "elm": {
      "annotationPrefix": " // ",
    },
    "c": {
      "annotationPrefix": " // ",
    },
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "mssql.enableRichExperiencesDoNotShowPrompt": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.editor.empty.hint": "hidden",
  "vscode-neovim.neovimClean": true,
  "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
  "update.enableWindowsBackgroundUpdates": false,
  "update.mode": "none",
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "AA94954D-7050-4602-AF3F-B0FB6CE2B59D",
    },
  ],
  "mssql.connections": [],
  "powershell.promptToUpdatePowerShell": false,
  "git.autofetch": true,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.commandsToSkipShell": [""],
  "files.autoSave": "afterDelay",
  // Fix for memory overflow issues (e.g., GitHub Copilot, tsup, Node.js)
  "typescript.tsserver.maxTsServerMemory": 32768,
  "terminal.integrated.env.windows": {
    "NODE_OPTIONS": "--max-old-space-size=32768",
  },
  "terminal.integrated.env.linux": {
    "NODE_OPTIONS": "--max-old-space-size=32768",
  },
  "terminal.integrated.env.osx": {
    "NODE_OPTIONS": "--max-old-space-size=32768",
  },
  "extensions.autoUpdate": false,
  "git.blame.editorDecoration.enabled": true,
  "workbench.iconTheme": "material-icon-theme",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "files.trimTrailingWhitespace": true,
  "workbench.commandPalette.experimental.suggestCommands": true,
  "[shellscript]": {
    "files.eol": "\n",
    "editor.defaultColorDecorators": "never",
  },
  "workbench.editor.enablePreview": false,
  "diffEditor.maxComputationTime": 0,
  "chat.tools.terminal.autoApprove": {
    "openspec": true,
    "ConvertFrom-Json": true,
    "dotnet build": true,
    "dotnet test": true,
    "ConvertTo-Json": true,
    "dotnet restore": true,
    "Test-Path": true,
    "dotnet nuget": true,
    "dotnet package": true,
    "ForEach-Object": true,
    "dotnet run": true,
    "busted": true,
    "New-Item": true,
    "Out-Null": true,
    "Tee-Object": true,
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
  },
  "chat.agent.maxRequests": 70,
  "chat.checkpoints.showFileChanges": true,
  "chat.planAgent.defaultModel": "Auto (copilot)",
  "chat.editing.explainChanges.enabled": true,
  "chat.tips.enabled": true,
  "chat.viewProgressBadge.enabled": true,
  "inlineChat.defaultModel": "Auto (copilot)",
  "inlineChat.enableV2": true,
  "inlineChat.affordance": "gutter",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "chat.viewSessions.orientation": "stacked",
  "chat.agentFilesLocations": {
    ".agents": true,
  },
  "chatgpt.localeOverride": "en-US",
  "workbench.secondarySideBar.showLabels": false,
  "chat.mcp.gallery.enabled": true,
  "git.replaceTagsWhenPull": true,
}
